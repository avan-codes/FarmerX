{
  "rule_set_id": "rs_in-mh_wheat_vegetative_v1",
  "version": "1.0.0",
  "status": "approved",
  "crop_id": "wheat",
  "region_id": "IN-MH",
  "stage_id": "vegetative",
  "effective_from": "2020-01-01",
  "source": {
    "document": "Maharashtra Package of Practices \u2014 Wheat, vegetative",
    "publisher": "FarmerX",
    "url": "https://example.invalid/in-mh-wheat-vegetative"
  },
  "validated_by": {
    "agronomist": "FarmerX",
    "date": "2020-01-01"
  },
  "thresholds_ref": "soil_thresholds.json#IN-MH",
  "rules": [
    {
      "rule_id": "r_wheat_IN-MH_vegetative_n_low",
      "when": {
        "all": [
          {
            "param": "N",
            "op": "lt",
            "value_ref": "thresholds.N.low"
          }
        ]
      },
      "then": [
        {
          "action_id": "a_wheat_IN-MH_vegetative_urea_vegetative",
          "fertilizer_id": "urea",
          "dose": {
            "value": "35",
            "unit": "kg",
            "basis": "per_acre"
          },
          "timing": "top_dress",
          "method": "broadcast",
          "reason_key": "reason.n_low_vegetative",
          "cautions": []
        }
      ]
    },
    {
      "rule_id": "r_wheat_IN-MH_vegetative_p_low",
      "when": {
        "all": [
          {
            "param": "P",
            "op": "lt",
            "value_ref": "thresholds.P.low"
          }
        ]
      },
      "then": [
        {
          "action_id": "a_wheat_IN-MH_vegetative_dap_vegetative",
          "fertilizer_id": "dap",
          "dose": {
            "value": "25",
            "unit": "kg",
            "basis": "per_acre"
          },
          "timing": "top_dress",
          "method": "broadcast",
          "reason_key": "reason.p_low_vegetative",
          "cautions": []
        }
      ]
    },
    {
      "rule_id": "r_wheat_IN-MH_vegetative_k_low",
      "when": {
        "all": [
          {
            "param": "K",
            "op": "lt",
            "value_ref": "thresholds.K.low"
          }
        ]
      },
      "then": [
        {
          "action_id": "a_wheat_IN-MH_vegetative_mop_vegetative",
          "fertilizer_id": "mop",
          "dose": {
            "value": "20",
            "unit": "kg",
            "basis": "per_acre"
          },
          "timing": "top_dress",
          "method": "broadcast",
          "reason_key": "reason.k_low_vegetative",
          "cautions": []
        }
      ]
    },
    {
      "rule_id": "r_wheat_IN-MH_vegetative_soil_adequate",
      "when": {
        "all": [
          {
            "param": "N",
            "op": "gte",
            "value_ref": "thresholds.N.low"
          },
          {
            "param": "P",
            "op": "gte",
            "value_ref": "thresholds.P.low"
          },
          {
            "param": "K",
            "op": "gte",
            "value_ref": "thresholds.K.low"
          }
        ]
      },
      "then": [
        {
          "action_id": "a_wheat_IN-MH_vegetative_vermicompost_adequate",
          "fertilizer_id": "vermicompost",
          "dose": {
            "value": "0",
            "unit": "kg",
            "basis": "per_acre"
          },
          "timing": "top_dress",
          "method": "broadcast",
          "reason_key": "reason.soil_adequate",
          "cautions": []
        }
      ]
    }
  ]
}