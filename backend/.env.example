# --- AI layer ---------------------------------------------------------------
LLM_PROVIDER=none                 # none | nim
NVIDIA_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.1-8b-instruct
NIM_FALLBACK_MODELS=              # optional comma-separated, e.g. meta/llama-3.3-70b-instruct
NIM_GUIDED_JSON=true
AI_MAX_TOKENS=512
AI_REQUEST_TIMEOUT_S=30
AI_CONNECT_TIMEOUT_S=5
AI_DAILY_TOKEN_BUDGET=200000
AI_DAILY_REQUEST_BUDGET=500
AI_USER_REQUESTS_PER_MINUTE=6
AI_CACHE_TTL_HOURS=168
AI_MAX_HISTORY_MESSAGES=12
AI_MAX_MESSAGE_CHARS=2000
NIM_COST_PER_1K_INPUT_USD=0
NIM_COST_PER_1K_OUTPUT_USD=0

# --- PDF --------------------------------------------------------------------
PDF_TEMPLATE_VERSION=1
PDF_FONT_DIR=data/fonts
PDF_CACHE_DIR=data/store/_pdf_cache

# --- Market prices ----------------------------------------------------------
MARKET_INGEST_ENABLED=true
MARKET_INGEST_INTERVAL_MINUTES=360
DATA_GOV_API_KEY=
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_BASE_URL=https://api.data.gov.in
MARKET_STALE_AFTER_HOURS=48

# --- News -------------------------------------------------------------------
NEWS_INGEST_ENABLED=true
NEWS_INGEST_INTERVAL_MINUTES=60
NEWS_FEEDS=["https://www.pib.gov.in/RssMain.aspx?ModId=6&Lang=1&Regid=3","https://www.thehindu.com/business/agri-business/feeder/default.rss"]
NEWS_STALE_AFTER_HOURS=24
NEWS_MAX_ITEMS_PER_FEED=40
