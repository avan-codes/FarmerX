{
  "rule_set_id": "rs_in-br_rice_basal_v1",
  "version": "1.0.0",
  "status": "approved",
  "crop_id": "rice",
  "region_id": "IN-BR",
  "stage_id": "basal",
  "effective_from": "2020-01-01",
  "source": {
    "document": "Bihar Package of Practices \u2014 Rice, basal",
    "publisher": "FarmerX",
    "url": "https://example.invalid/in-br-rice-basal"
  },
  "validated_by": {
    "agronomist": "FarmerX",
    "date": "2020-01-01"
  },
  "thresholds_ref": "soil_thresholds.json#IN-BR",
  "rules": [
    {
      "rule_id": "r_rice_IN-BR_basal_n_low",
      "when": {
        "all": [
          {
            "param": "N",
            "op": "lt",
            "value_ref": "thresholds.N.low"
          }
        ]
      },
      "then": [
        {
          "action_id": "a_rice_IN-BR_basal_urea_basal",
          "fertilizer_id": "urea",
          "dose": {
            "value": "55",
            "unit": "kg",
            "basis": "per_acre"
          },
          "timing": "basal",
          "method": "broadcast",
          "reason_key": "reason.n_low_basal",
          "cautions": []
        }
      ]
    },
    {
      "rule_id": "r_rice_IN-BR_basal_p_low",
      "when": {
        "all": [
          {
            "param": "P",
            "op": "lt",
            "value_ref": "thresholds.P.low"
          }
        ]
      },
      "then": [
        {
          "action_id": "a_rice_IN-BR_basal_dap_basal",
          "fertilizer_id": "dap",
          "dose": {
            "value": "60",
            "unit": "kg",
            "basis": "per_acre"
          },
          "timing": "basal",
          "method": "broadcast",
          "reason_key": "reason.p_low_basal",
          "cautions": []
        }
      ]
    },
    {
      "rule_id": "r_rice_IN-BR_basal_k_low",
      "when": {
        "all": [
          {
            "param": "K",
            "op": "lt",
            "value_ref": "thresholds.K.low"
          }
        ]
      },
      "then": [
        {
          "action_id": "a_rice_IN-BR_basal_mop_basal",
          "fertilizer_id": "mop",
          "dose": {
            "value": "50",
            "unit": "kg",
            "basis": "per_acre"
          },
          "timing": "basal",
          "method": "broadcast",
          "reason_key": "reason.k_low_basal",
          "cautions": []
        }
      ]
    },
    {
      "rule_id": "r_rice_IN-BR_basal_soil_adequate",
      "when": {
        "all": [
          {
            "param": "N",
            "op": "gte",
            "value_ref": "thresholds.N.low"
          },
          {
            "param": "P",
            "op": "gte",
            "value_ref": "thresholds.P.low"
          },
          {
            "param": "K",
            "op": "gte",
            "value_ref": "thresholds.K.low"
          }
        ]
      },
      "then": [
        {
          "action_id": "a_rice_IN-BR_basal_vermicompost_adequate",
          "fertilizer_id": "vermicompost",
          "dose": {
            "value": "0",
            "unit": "kg",
            "basis": "per_acre"
          },
          "timing": "basal",
          "method": "broadcast",
          "reason_key": "reason.soil_adequate",
          "cautions": []
        }
      ]
    }
  ]
}